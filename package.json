{
    "name": "esport-prediction-bot",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "clean": "rimraf dist",
        "build": "tsc",
        "db:codegen": "kysely-codegen --dialect sqlite --camel-case --out-file ./src/database/kysely-types.d.ts",
        "lint": "biome lint --write ./src/**/*",
        "lint:fix": "biome check --fix ./src/**/*",
        "format": "biome format --write ./src/**/*",
        "dev": "tsx src/bot.ts",
        "start": "node dist/src/bot.js",
        "commands:deploy": "pnpm build && node dist/src/deploy-command.js"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "better-sqlite3": "^11.10.0",
        "dayjs": "^1.11.13",
        "discord.js": "^14.19.3",
        "discord.js-rate-limiter": "^1.3.2",
        "dotenv": "^16.5.0",
        "kysely": "^0.28.2",
        "node-schedule": "^2.1.1",
        "pino": "^9.6.0",
        "pino-pretty": "^13.0.0",
        "zod": "^3.24.4"
    },
    "devDependencies": {
        "@biomejs/biome": "1.9.4",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node-schedule": "^2.1.7",
        "kysely-codegen": "^0.18.5",
        "rimraf": "^6.0.1",
        "tsx": "^4.19.4",
        "typescript": "^5.8.3"
    },
    "type": "module"
}
