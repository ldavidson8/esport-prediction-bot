{
    "name": "esport-prediction-bot",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "start": "node dist/src/bot.js",
        "build": "rimraf dist && tsgo",
        "type-check": "tsgo --noEmit",
        "db:migrate": "tsx ./scripts/runMigration.ts",
        "db:rollback": "tsx ./scripts/runMigration.ts --to 0",
        "db:codegen": "kysely-codegen --dialect sqlite --camel-case --out-file ./src/database/kysely-types.d.ts",
        "migration:create": "tsx ./scripts/createMigration.ts",
        "lint": "oxlint",
        "format": "oxfmt",
        "commands:deploy": "node dist/src/deploy-command.js",
        "sync:manual": "tsx src/jobs/liquipedia-cron.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "better-sqlite3": "^12.5.0",
        "cron": "^4.4.0",
        "date-fns": "^4.1.0",
        "discord.js": "^14.25.1",
        "dotenv": "^17.2.3",
        "kysely": "^0.28.9",
        "neverthrow": "^8.2.0",
        "pino": "^10.1.0",
        "pino-pretty": "^13.1.3",
        "zod": "^4.1.13"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@typescript/native-preview": "7.0.0-dev.20251213.1",
        "kysely-codegen": "^0.19.0",
        "oxfmt": "^0.17.0",
        "oxlint": "^1.32.0",
        "oxlint-tsgolint": "^0.9.0",
        "rimraf": "^6.1.2",
        "tsx": "^4.21.0"
    }
}