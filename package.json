{
    "name": "esport-prediction-bot",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "start": "node dist/src/bot.js",
        "build": "rimraf dist && tsc",
        "type-check": "tsc --noEmit",
        "watch": "tsc --watch",
        "db:migrate": "tsx ./scripts/migrate.ts",
        "db:rollback": "tsx ./scripts/migrate.ts --to 0",
        "db:codegen": "kysely-codegen --dialect sqlite --camel-case --out-file ./src/database/kysely-types.d.ts",
        "lint": "biome lint --write ./src/**/*",
        "lint:fix": "biome check --fix ./src/**/*",
        "format": "biome format --write ./src/**/*",
        "commands:deploy": "node dist/src/deploy-command.js",
        "sync:manual": "tsx src/jobs/liquipedia-cron.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@better-fetch/fetch": "^1.1.18",
        "better-sqlite3": "^11.10.0",
        "cron": "^4.3.0",
        "date-fns": "^4.1.0",
        "discord.js": "^14.19.3",
        "dotenv": "^16.5.0",
        "kysely": "^0.28.2",
        "pino": "^9.6.0",
        "pino-pretty": "^13.0.0",
        "zod": "^3.24.4"
    },
    "devDependencies": {
        "@biomejs/biome": "1.9.4",
        "@types/better-sqlite3": "^7.6.13",
        "kysely-codegen": "^0.18.5",
        "rimraf": "^6.0.1",
        "tsx": "^4.19.4",
        "typescript": "^5.8.3"
    },
    "type": "module"
}